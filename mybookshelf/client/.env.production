# .env.production — environment variables used when building for production
# (i.e. `npm run build`). Vite automatically loads this file for prod builds.
#
# Only variables prefixed with VITE_ are exposed to the frontend code.
# This is NOT a secret — it's just the public URL of the deployed backend.

# The Render backend URL. The "/api" path is added in src/api/books.js.
VITE_API_URL=https://mybookshelf-okln.onrender.com
