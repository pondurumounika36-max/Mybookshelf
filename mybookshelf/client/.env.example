# .env.example — template for the frontend's environment variables.
#
# Vite loads env files automatically:
#   - .env              -> always
#   - .env.production   -> only during `npm run build`
#   - .env.local        -> always, but gitignored (good for personal overrides)
#
# Only variables prefixed with VITE_ are exposed to the browser code via
# import.meta.env.

# Base URL of the backend API server (no trailing slash, no "/api").
# Leave this UNSET in development so requests use the Vite proxy ("/api").
# In production it points at the deployed Render backend.
VITE_API_URL=https://mybookshelf-okln.onrender.com
